# Base44-Projekt-Defaults fuer die Entwicklungsumgebung.
#
# Nur unkritische Vorgaben, die die App auch ohne Zugangsdaten sinnvoll
# laufen lassen. Echte Secrets kommen aus /run/base44/app.env und haben
# Vorrang (spaeteres env_file in docker-compose.base44.yml).
#
# Zeitzone des Analytik-Rasters (Vercel/Container laufen in UTC; ohne
# Angabe waere der Tagesgang im Sommer um zwei Stunden verschoben).
ANALYTIK_ZEITZONE=Europe/Berlin
