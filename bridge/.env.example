# Zugangsdaten der Tapo TCA72 (Kamerakonto, NICHT der TP-Link-Cloud-Login)
TAPO_IP=192.168.178.117
TAPO_USER=Stallwache
TAPO_PASS=changeme

# Login der go2rtc-Schnittstelle. Dringend BEIDE setzen: Ohne Login nimmt
# go2rtc aus dem ganzen Stall-WLAN Befehle an. Passwort z. B. mit
#   openssl rand -hex 16
# erzeugen (nur Buchstaben/Ziffern, keine Anfuehrungszeichen). Beide leer =
# ohne Login. Der Edge-Agent braucht dieselben Daten fuer seinen
# Snapshot-Fallback (stream.fallback_snapshot_url = http://BENUTZER:PASSWORT@<ip>:1984/…).
GO2RTC_API_USER=
GO2RTC_API_PASS=

# Zweitkamera "Futterwache" (optional; leer lassen, wenn nur eine Kamera existiert)
FUTTER_IP=192.168.178.118
FUTTER_USER=Futterwache
FUTTER_PASS=changeme
