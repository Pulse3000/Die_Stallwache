# Oeffentliche Adresse der Bridge (Cloudflare-Tunnel-Hostname).
# Ohne abschliessenden Slash. (Alt-Name NEXT_PUBLIC_GO2RTC_URL funktioniert
# weiterhin als Alias.)
NEXT_PUBLIC_BRIDGE_URL=https://stallwache.example.com

# Welche Bridge-Software laeuft dahinter? "go2rtc" (Default) oder "mediamtx".
# Entscheidungshilfe: bridge/README.md
NEXT_PUBLIC_BRIDGE_TYPE=go2rtc

# Stream/Pfad der Hauptkamera "Stallwache" (Default: stallwache)
NEXT_PUBLIC_STREAM_NAME=stallwache

# Stream/Pfad der Zweitkamera "Futterwache" (Default: futterwache)
NEXT_PUBLIC_STREAM_NAME_2=futterwache

# Stream/Pfad der Drittkamera "Abkalbebox" (Default: abkalbebox)
# Diese Kamera hiess frueher "Stallbox"; die alten Variablennamen gelten
# weiter als Alias, damit ein bestehendes Deployment nicht ausfaellt.
NEXT_PUBLIC_STREAM_NAME_3=abkalbebox

# Stream/Pfad der Viertkamera "Weidewache" (Default: weidewache)
NEXT_PUBLIC_STREAM_NAME_4=weidewache

# Die Tuya-Kameras als Hauptbild ueber die Tuya-Cloud (mit Bridge-Fallback).
# Standardmaessig aktiv; auf 0 setzen, um die jeweilige Kamera rein ueber die
# Bridge laufen zu lassen (dann wird deren TUYA_DEVICE_ID_* ignoriert).
NEXT_PUBLIC_FUTTERWACHE_TUYA=1
NEXT_PUBLIC_ABKALBEBOX_TUYA=1
NEXT_PUBLIC_WEIDEWACHE_TUYA=1

# --- Tuya-Cloud - NUR serverseitig in Vercel setzen, nie NEXT_PUBLIC! ---
# Ein Access-ID/Secret-Paar gilt fuers ganze Tuya-Cloud-Projekt; jede Kamera
# bekommt ihre eigene Geraete-ID.
# TUYA_ACCESS_ID=
# TUYA_ACCESS_SECRET=
# TUYA_DEVICE_ID_FUTTERWACHE=
# TUYA_DEVICE_ID_ABKALBEBOX=      (Alias: TUYA_DEVICE_ID_STALLBOX)
# TUYA_DEVICE_ID_WEIDEWACHE=
# TUYA_API_BASE=https://openapi.tuyaeu.com

# --- Passwortschutz (optional) - NUR serverseitig, nie NEXT_PUBLIC! ---
# Setzen aktiviert den Login-Schutz fuer die gesamte App (ein gemeinsames
# Passwort). Leer/ungesetzt = App bleibt offen.
# STALLBLICK_PASSWORT=
# Optionaler Signaturschluessel fuer das Session-Cookie (Default: Passwort).
# Eigenen Wert setzen, damit Sessions nicht bei Passwortwechsel-Logik brechen.
# STALLBLICK_AUTH_SECRET=

# --- Edge-Agent-Ingest fuer die KI-Wache (POST /api/events) ---
# EDGE_INGEST_TOKEN=

# --- Push-Benachrichtigungen (Firebase Cloud Messaging) ---
# Ohne diese Variablen bleibt die App voll nutzbar, meldet sich aber nicht
# von selbst - der Landwirt muss dann aktiv nachschauen.
#
# 1) Serverseitiger Versand: Service Account mit FCM-Recht
#    (Firebase-Konsole -> Projekteinstellungen -> Dienstkonten -> Schluessel).
#    JSON entweder direkt oder Base64-kodiert (einzeilig, praktischer in Vercel).
# GCP_SERVICE_ACCOUNT_JSON=
# GCP_PROJECT_ID=
# FIREBASE_PROJECT_ID=          # nur noetig, wenn abweichend von GCP_PROJECT_ID
#
# 2) Browser-Anmeldung: Web-App-Konfiguration aus der Firebase-Konsole.
#    Diese Werte sind nach Firebase-Design oeffentlich; sie stehen hier
#    trotzdem serverseitig, damit ein Projektwechsel kein Rebuild braucht.
# FIREBASE_API_KEY=
# FIREBASE_AUTH_DOMAIN=         # Default: <projekt>.firebaseapp.com
# FIREBASE_MESSAGING_SENDER_ID=
# FIREBASE_APP_ID=
# FIREBASE_VAPID_KEY=           # Cloud Messaging -> Web Push -> Schluesselpaar
#
# 3) Ab welchem Alter ein Ereignis nur noch ins Protokoll wandert statt zu
#    klingeln (Minuten, Default 30). Verhindert 40 Toene auf einmal, wenn der
#    Edge-Agent nach einem Funkloch seinen Puffer nachliefert.
# PUSH_MAX_ALTER_MINUTEN=30

# --- Anbindung an die bestehende GCP-Architektur ---
# Jedes eingehende Ereignis wird zusaetzlich in dieses Pub/Sub-Topic
# gespiegelt (Cloud Functions, BigQuery, YOLO-Nachanalyse). Leer = aus.
# Der Service Account braucht dafuer roles/pubsub.publisher.
# PUBSUB_TOPIC=stall-ereignisse

# --- Assistent (Freitext-/Sprachanfragen) ---
# Ohne beides beantwortet die App Fragen nach Tier, Art und Zeitraum selbst
# aus dem Ereignisprotokoll - nur freier formulierte Fragen brauchen die KI.
# Weg A: Vertex AI ueber den Service Account oben (roles/aiplatform.user)
# VERTEX_LOCATION=europe-west4
# VERTEX_MODEL=gemini-2.5-flash
# Weg B: Gemini-API mit Schluessel (ohne Service Account)
# GEMINI_API_KEY=

# --- Steuerbare Tuya-Geraete (Traenken, Licht, Sensoren) ---
# Zugleich die Allowlist: die App steuert ausschliesslich, was hier steht.
# Format: <geraete-id>:<Anzeigename>:<art>, kommagetrennt.
# Arten: traenke | licht | steckdose | sensor | kamera | sonstiges
# Die Kameras oben erscheinen automatisch mit ihrem Online-Status und muessen
# hier NICHT eingetragen werden.
# TUYA_GERAETE=bf1a...:Powerwache:steckdose,bf2b...:Tränke Bucht 1:traenke
